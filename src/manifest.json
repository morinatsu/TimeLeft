{
  "manifest_version": 3,
  "name": "TimeLeft",
  "version": "1.1.1",
  "description": "A horizontal timer extension with smooth gradients.",
  "permissions": [
    "notifications"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}